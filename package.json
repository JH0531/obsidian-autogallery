    "check:demo": "node scripts/check-demo.mjs",
    "check:docs": "node tools/docs/facts.mjs && node tools/docs/claims.mjs && node tools/docs/check.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "esbuild": "^0.25.0",
    "obsidian": "^1.13.1"
  }
}
