          "floatAlignment": "left",
          "side": "auto"
        }
      ]
    },
    {
      "id": "tight",
      "name": "tight",
      "floatAlignment": "right",
      "rules": [
        {
          "ratioRange": "(0.2,5]",
          "width": 0.4,
          "layout": "float",
          "floatAlignment": "right",
          "side": "auto"
        }
      ]
    }
